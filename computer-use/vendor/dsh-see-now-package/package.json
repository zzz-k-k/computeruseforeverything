{
  "name": "dsh-see-now",
  "version": "0.1.2",
  "description": "Let DSH watch a live screen or camera feed: score every frame by how much the picture changed, keep only the ones that matter, and pack them into one image. · 让 AI 实时看见你的屏幕，只传「画面变了」的那几帧。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "screen-capture",
    "vision",
    "llm",
    "ffmpeg",
    "realtime",
    "token-efficient",
    "multimodal"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./pack": "./src/pack.js",
    "./png": "./src/png.js",
    "./pipeline": "./src/pipeline.js",
    "./tokens": "./src/tokens.js",
    "./capture": "./src/capture.js",
    "./chat": "./src/chat.js",
    "./speech": "./src/speech.js",
    "./voice": "./src/voice.js",
    "./interject": "./src/interject.js",
    "./window": "./src/window.js",
    "./runner": "./src/runner.js",
    "./loop": "./src/loop.js",
    "./timer": "./src/timer.js",
    "./tool-spec": "./src/tool-spec.js"
  },
  "files": [
    "bin",
    "src",
    "examples/floating-chat/*.py",
    "examples/floating-chat/*.png",
    "examples/voice-say-mac.mjs",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "CREDITS.md",
    "LICENSE",
    "NOTICE",
    "docs/images"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "debug:live": "node debug/live.mjs",
    "install-dev": "node scripts/install-dev.mjs",
    "check": "node scripts/install-dev.mjs --check",
    "sync:window": "node scripts/sync-window.mjs",
    "check:window": "node scripts/sync-window.mjs --check",
    "prepack": "node scripts/sync-window.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  },
  "author": "SAOS-3624",
  "contributors": [
    {
      "name": "ggfgfgf-on",
      "url": "https://github.com/ggfgfgf-on"
    },
    {
      "name": "xingranya",
      "url": "https://github.com/xingranya"
    },
    {
      "name": "citydirector",
      "url": "https://github.com/citydirector"
    },
    {
      "name": "zhumengaoxuan",
      "url": "https://github.com/zhumengaoxuan"
    },
    {
      "name": "gao804",
      "url": "https://github.com/gao804"
    },
    {
      "name": "caijialin20051003-gif",
      "url": "https://github.com/caijialin20051003-gif"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAOS-3624/dsh-see-now.git"
  },
  "homepage": "https://github.com/SAOS-3624/dsh-see-now#readme",
  "bugs": {
    "url": "https://github.com/SAOS-3624/dsh-see-now/issues"
  },
  "bin": {
    "dsh-see-window": "bin/see-window.mjs"
  }
}
